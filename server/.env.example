# Copie para .env e preencha antes de correr em produção.
# Sem estes valores, o servidor arranca na mesma — só regista os pedidos na
# base de dados e simula o envio (fica registado na consola).

PORT=3001

# Origem permitida a chamar esta API (o endereço do site).
CORS_ORIGIN=http://localhost:5173

# Onde fica o ficheiro da base de dados (SQLite).
DATABASE_PATH=./data/vektra.db

# Servidor SMTP que envia o email de cada pedido de orçamento. Pode ser o
# próprio email profissional da Vektra (@vektratechnologies.com, assim que o
# pacote de Domínios & Hosting estiver ativo), Gmail, ou qualquer fornecedor
# transacional (Resend, Mailgun, SendGrid — todos falam SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Para onde o pedido de orçamento é enviado.
CONTACT_TO_EMAIL=contacto@vektratechnologies.com
