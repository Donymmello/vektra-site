# Copy to .env and adjust before running `docker compose up -d`.
DOMAIN=vektramz.com
ACME_EMAIL=admin@vektramz.com

# Google Analytics 4 Measurement ID (format G-XXXXXXXXXX), from
# analytics.google.com → Admin → Data streams → your web stream.
# Leave empty to keep GA disabled: the cookie-consent banner still shows,
# it just never loads any tracking script until this is filled in and the
# site is rebuilt (`docker compose up -d --build site`).
VITE_GA_MEASUREMENT_ID=
